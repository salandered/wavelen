# Every variable wavelen reads. An empty value means the default noted above it.
# This file is committed - keep it empty. Copy it to .env, which is gitignored.
#
# Both `docker compose` and the Makefile read .env, and make parses it as makefile
# syntax: write a bare value, no quotes and no trailing '#' comment.

# ---- Database ----

# Required, no default
POSTGRES_USER=
POSTGRES_PASSWORD=

# default: wavelen
POSTGRES_DB=

# Client side only, the container is unaffected.
# default: localhost
POSTGRES_HOST=

# Published on the host by docker compose.
# default: 5433 (5432 is often used)
POSTGRES_PORT=

# Client side only.
# default: disable
POSTGRES_SSLMODE=

# ---- HTTP server ----

# default: 8080
PORT=

# default: 10s
SHUTDOWN_TIMEOUT=

# ---- Logging, read by slogenv ----

# debug | info | warn | error
# default: info
LOG_LEVEL=

# text | json
# default: text
LOG_FORMAT=

# Log to file 
# default: empty (means stdout)
LOG_FILE=

# sec | milli | nano | dt-sec | dt-milli | rfc3339 | rfc3339nano
# default: dt-milli
LOG_TIME=
