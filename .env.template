# An empty value usually means the default
# Both `docker compose` and the Makefile read .env

# ---- Database ----

# Required, no default
POSTGRES_USER=
POSTGRES_PASSWORD=

# default: wavelen
POSTGRES_DB=

# The app container ignores it and reaches postgres by service name.
# default: localhost
POSTGRES_HOST=

# Inside the compose network postgres is on 5432 regardless.
# default: 5433 (5432 is often used)
POSTGRES_PORT=

# The app container is always 'disable'.
# default: disable
POSTGRES_SSLMODE=

# ---- HTTP server ----

# Also the port docker compose publishes on the host
# default: 8080
PORT=

# default: 10s
SHUTDOWN_TIMEOUT=

# Amount of colors one user can hold
# default: 100
USER_COLOR_QUOTA=

# How long a login token stays valid
# default: 24h
AUTH_TOKEN_TTL=

# ---- Web UI ----

# Host port for the optional caddy container
# default: 8099
UI_PORT=

# ---- Logging for slogenv ----

# debug | info | warn | error
# default: info
LOG_LEVEL=

# text | json
# default: text
LOG_FORMAT=

# Log to file 
# default: empty (means stdout)
LOG_FILE=

# sec | milli | nano | dt-sec | dt-milli | rfc3339 | rfc3339nano
# default: dt-milli
LOG_TIME=
